<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Tema base do app antes do Compose pegar.
      Material Dark NoActionBar evita o flash branco entre splash → setContent.
      O esquema de cores real é definido em BillFolderTheme (Compose).
    -->
    <style name="Theme.BillFolder" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
